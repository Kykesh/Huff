    "scm.repositories.selectionMode": "multiple",
    "scm.alwaysShowRepositories": true,
    "python.defaultInterpreterPath": "/Users/kylehuffsr./.local/gojo-venv/bin/python",
    "python.analysis.diagnosticMode": "openFilesOnly",
    "files.exclude": {
      "**/.next": true,
      "**/node_modules": true,
      "**/__pycache__": true,
      "**/.venv": true
    },
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/.next/**": true,
      "**/.venv/**": true,
      "**/data/**": true,
      "**/__pycache__/**": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.next": true,
      "**/.venv": true,
      "**/data": true
    }
  }
